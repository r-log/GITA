# ===========================================
# GitHub Assistant — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- GitHub App ---
# Get these from: GitHub > Settings > Developer Settings > GitHub Apps > Your App
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
# The App's slug (github.com/apps/<slug>). When set, only GITA's own bot
# account is ignored, so Dependabot/Renovate PRs still get reviewed.
# When unset, events from every bot are ignored.
GITHUB_APP_SLUG=

# --- Database ---
# docker-compose.yml publishes Postgres on host port 5433.
DATABASE_URL=postgresql+asyncpg://github_assistant:password@localhost:5433/github_assistant

# --- Redis (for background task queue) ---
# Uses 127.0.0.1 instead of localhost — on Windows, localhost resolves
# to IPv6 (::1) while Docker only binds IPv4.
REDIS_URL=redis://127.0.0.1:6379

# --- AI Provider (OpenRouter) ---
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx

# --- Embeddings (OpenAI) ---
# Used for semantic code search (text-embedding-3-small, 1536 dims).
# Optional — when absent, concept search falls back to keyword-only FTS.
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# Default model for agents (can be overridden per-agent)
# Popular choices: openai/gpt-4o, anthropic/claude-sonnet-4, meta-llama/llama-3.1-70b
AI_DEFAULT_MODEL=openai/gpt-4o

# --- Cloudflare Tunnel ---
# Only needed if using Cloudflare Tunnel for webhook delivery
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# --- App Settings ---
GITA_LOG_LEVEL=INFO
ENVIRONMENT=development

# Write-mode gate — controls whether agent decisions mutate GitHub state.
#   shadow  = log only, never execute (DEFAULT — safe for development)
#   comment = execute comments, downgrade everything else to a comment
#   full    = execute anything that passes its confidence threshold
# NEVER commit this file with WRITE_MODE=comment or =full.
# Only flip deliberately for one-shot Day-7-style live runs, then flip back.
WRITE_MODE=shadow

# --- Event handling ---
# Onboarding runs when this label is applied to an issue by someone with
# triage access (or self-applied by an owner/member/collaborator).
ONBOARDING_LABEL=gita:onboard
# PR reviews wait this long so a burst of pushes yields one review of
# the newest commit.
REVIEW_DEBOUNCE_SECONDS=20

# --- Test generation sandbox ---
# Generated tests are executed to verify them. They import repository
# code, so they are untrusted. "docker" runs each verification in a
# locked-down container (no network, no host env, read-only mount) and is
# required for webhook-triggered generation. "local" is a scrubbed
# subprocess for repositories you already trust; it is NOT isolation.
TEST_GEN_SANDBOX=docker
# Must contain python + pytest + the target repo's dependencies.
# Build the base: docker build -f docker/sandbox.Dockerfile -t gita-sandbox:latest docker/
TEST_GEN_SANDBOX_IMAGE=gita-sandbox:latest
TEST_GEN_TIMEOUT_SECONDS=90

# Webhook URL (set this in your GitHub App settings)
# If using Cloudflare Tunnel: https://gh-assistant.yourdomain.com/api/webhooks/github
# If local dev with smee.io: https://smee.io/your-channel-id
WEBHOOK_PROXY_URL=
